# Copy to .env.local. Everything is optional: with no keys the app still runs
# (example token + keyless RPC log-replay scans for smaller tokens).

# Public URL, used for OG/share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data providers -----------------------------------------------------------
# Blockscout PRO (one key for chain ids 4663 / 8453 / 1). Enables top-holder lists
# and explorer tags; required to scan large tokens.
BLOCKSCOUT_API_KEY=
# Envio HyperSync token. Enables full transfer history fast and shared gas-funder links.
HYPERSYNC_TOKEN=

# RPC overrides (defaults are public endpoints)
RPC_ROBINHOOD=
RPC_BASE=
RPC_ETHEREUM=

# --- Storage --------------------------------------------------------------------
# Postgres connection string. Without it, snapshots are JSON files in ./.data
# (or /tmp on Vercel, which does not persist between invocations).
DATABASE_URL=

# --- Sealing (Audit Receipts) --------------------------------------------------
# AuditAnchor contract on Robinhood Chain (contracts/AuditAnchor.sol) and the key of
# its `writer`. Leave empty to hash snapshots without anchoring.
ANCHOR_CONTRACT=
ANCHOR_PRIVATE_KEY=
SEAL_BATCH_SIZE=16
SEAL_MAX_WAIT_MIN=10
# Protects GET /api/seal/flush (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# --- Content ------------------------------------------------------------------
# Official $STRING token address on Robinhood Chain (pinned on Explore once set)
NEXT_PUBLIC_STRING_ADDRESS=
# Extra labels / categories without a deploy, e.g.
# LABELS_JSON={"robinhood":{"0xabc…":{"type":"cex","label":"Some exchange"}}}
LABELS_JSON=
CATEGORIES_JSON=
# Scans per client per 10 minutes
SCAN_RATE_LIMIT=10
