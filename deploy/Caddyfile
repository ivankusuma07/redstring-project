# REDSTRING site for the shared edge Caddy. Installed as /opt/edge/sites/redstring.caddy and
# imported by the edge Caddy (`import /etc/caddy/sites/*.caddy`); other projects keep their own files.
# Only /api/* is public.
api.redstringmap.site {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	@api path /api/*
	handle @api {
		# flush_interval -1: stream NDJSON scan progress as it is written
		reverse_proxy redstring-api:3000 {
			flush_interval -1
		}
	}
	handle {
		respond "REDSTRING API" 404
	}
}
